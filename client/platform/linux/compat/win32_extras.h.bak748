inline void* ShellExecuteA(HWND, LPCSTR /*op*/, LPCSTR file, LPCSTR, LPCSTR, INT)
{
	// Comportamento alinhado ao Win32: só “open” se o alvo existir.
	// Nunca passar a string por /bin/sh — URLs com aspas quebravam em command injection.
	if (!file || !file[0])
		return nullptr;

	const bool isUrl =
		std::strncmp(file, "http://", 7) == 0 ||
		std::strncmp(file, "https://", 8) == 0 ||
		std::strncmp(file, "mailto:", 7) == 0;

	auto spawnOpen = [](const char* target) -> void* {
		if (!target || !target[0])
			return nullptr;
		const pid_t pid = fork();
		if (pid == 0) {
			execlp("xdg-open", "xdg-open", target, static_cast<char*>(nullptr));
			_exit(127);
		}
		return pid > 0 ? reinterpret_cast<void*>(intptr_t(42)) : nullptr;
	};

	if (isUrl)
		return spawnOpen(file);

	const std::string nfile = WYD_NormalizePath(file);
	if (access(nfile.c_str(), F_OK) != 0)
		return nullptr;

	if (access(nfile.c_str(), X_OK) == 0) {
		const pid_t pid = fork();
		if (pid == 0) {
			execl(nfile.c_str(), nfile.c_str(), static_cast<char*>(nullptr));
			_exit(127);
		}
		return pid > 0 ? reinterpret_cast<void*>(intptr_t(42)) : nullptr;
	}

	char abs[PATH_MAX] {};
	if (!realpath(nfile.c_str(), abs))
		return nullptr;
	return spawnOpen(abs);
}
#define ShellExecute ShellExecuteA
