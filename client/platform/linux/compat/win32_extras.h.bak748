inline BOOL QueryPerformanceCounter(LARGE_INTEGER* li)
{
	using namespace std::chrono;
	const auto n = steady_clock::now().time_since_epoch().count();
	if (li)
		li->QuadPart = static_cast<LONGLONG>(n);
	return TRUE;
}
inline BOOL QueryPerformanceFrequency(LARGE_INTEGER* li)
{
	if (li)
		li->QuadPart = 1000000000LL;
	return TRUE;
}
inline void GlobalMemoryStatus(MEMORYSTATUS* ms)
{
	if (!ms)
		return;
	ms->dwLength = sizeof(*ms);
	ms->dwTotalPhys = 8ull << 30;
}
inline int MultiByteToWideChar(UINT, DWORD, LPCSTR s, int n, LPWSTR, int)
{
	return n < 0 ? static_cast<int>(std::strlen(s ? s : "")) + 1 : n;
}
inline int WideCharToMultiByte(UINT, DWORD, LPCWSTR, int n, LPSTR, int, LPCSTR, LPBOOL)
{
	return n < 0 ? 1 : n;
}

