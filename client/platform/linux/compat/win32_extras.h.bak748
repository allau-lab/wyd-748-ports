inline DWORD GetFullPathNameA(LPCSTR file, DWORD n, LPSTR buf, LPSTR* filePart)
{
	if (!file || !buf || !n)
		return 0;
	char* resolved = realpath(file, nullptr);
	if (!resolved) {
		std::strncpy(buf, file, n);
		buf[n - 1] = 0;
	} else {
		std::strncpy(buf, resolved, n);
		buf[n - 1] = 0;
		free(resolved);
	}
	if (filePart) {
		char* slash = std::strrchr(buf, '/');
		*filePart = slash ? slash + 1 : buf;
	}
	return static_cast<DWORD>(std::strlen(buf));
}
#define GetFullPathName GetFullPathNameA
#ifndef lstrcpyn
inline LPSTR lstrcpynA(LPSTR dst, LPCSTR src, int n)
{
	if (!dst || n <= 0)
		return dst;
	if (!src) {
		dst[0] = 0;
		return dst;
	}
	std::strncpy(dst, src, static_cast<size_t>(n - 1));
	dst[n - 1] = 0;
	return dst;
}
#define lstrcpyn lstrcpynA
#endif

