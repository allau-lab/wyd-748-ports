inline std::string WYD_NormalizePath(const char* path)
{
	std::string out = path ? path : "";
	for (char& c : out) {
		if (c == '\\')
			c = '/';
	}
	if (out.empty() || access(out.c_str(), F_OK) == 0)
		return out;

	// Pacote 7.48 mistura Mesh/mesh, Sound/sound etc. Windows ignora case; Linux não.
	std::string resolved;
	std::string remaining = out;
	// Absolute path prefix
	if (!remaining.empty() && remaining[0] == '/') {
		resolved = "/";
		remaining.erase(0, 1);
	}

	while (!remaining.empty()) {
		const auto slash = remaining.find('/');
		const std::string part = slash == std::string::npos ? remaining : remaining.substr(0, slash);
		if (slash == std::string::npos)
			remaining.clear();
		else
			remaining.erase(0, slash + 1);

		if (part.empty() || part == ".")
			continue;
		if (part == "..") {
			const auto p = resolved.find_last_of('/');
			if (p == std::string::npos || resolved.empty())
				resolved.clear();
			else if (p == 0)
				resolved = "/";
			else
				resolved.resize(p);
			continue;
		}

		const std::string probe = resolved.empty() ? part : (resolved.back() == '/' ? resolved + part : resolved + "/" + part);
		if (access(probe.c_str(), F_OK) == 0) {
			resolved = probe;
			continue;
		}

		const std::string parent = resolved.empty() ? "." : resolved;
		DIR* dir = opendir(parent.c_str());
		if (!dir)
			return out;
		std::string match;
		while (dirent* ent = readdir(dir)) {
			if (strcasecmp(ent->d_name, part.c_str()) == 0) {
				match = ent->d_name;
				break;
			}
		}
		closedir(dir);
		if (match.empty())
			return out;
		resolved = resolved.empty() ? match : (resolved.back() == '/' ? resolved + match : resolved + "/" + match);
	}
	return resolved.empty() ? out : resolved;
}

namespace wyd_io {
// Ponteiro para o fopen do libc, capturado ANTES do #define abaixo.
inline FILE* LibcFopen(const char* path, const char* mode)
{
	return std::fopen(path, mode);
}
}

inline FILE* Wyd_fopen(const char* path, const char* mode)
{
	const std::string npath = WYD_NormalizePath(path);
	return wyd_io::LibcFopen(npath.c_str(), mode);
}
// Paths do client usam '\\'; redireciona fopen CRT para normalizar no Linux.
#ifdef fopen
#undef fopen
#endif
#define fopen Wyd_fopen

inline int _open(const char* path, int flags, int = 0644)
{
	int fl = O_RDONLY;
	if (flags & _O_RDWR)
		fl = O_RDWR;
	if (flags & _O_CREAT)
		fl |= O_CREAT;
	if (flags & _O_TRUNC)
		fl |= O_TRUNC;
	const std::string npath = WYD_NormalizePath(path);
	return ::open(npath.c_str(), fl, 0644);
}
inline int _close(int fd) { return ::close(fd); }
inline long _filelength(int fd)
{
	struct stat st {};
	if (fstat(fd, &st) != 0)
		return -1;
	return static_cast<long>(st.st_size);
}
inline int _read(int fd, void* buf, unsigned n) { return static_cast<int>(::read(fd, buf, n)); }
inline int _write(int fd, const void* buf, unsigned n) { return static_cast<int>(::write(fd, buf, n)); }
inline long _lseek(int fd, long off, int whence) { return static_cast<long>(::lseek(fd, off, whence)); }
inline int _access(const char* p, int)
{
	const std::string npath = WYD_NormalizePath(p);
	return access(npath.c_str(), F_OK);
}

inline errno_t memcpy_s(void* d, size_t ds, const void* s, size_t n)
{
	if (!d || !s || n > ds)
		return 1;
	if (n)
		std::memcpy(d, s, n);
	return 0;
}


inline errno_t strcpy_s(char* d, size_t n, const char* s)
{
	if (!d || !s || n == 0 || std::strlen(s) >= n)
		return 1;
	std::memcpy(d, s, std::strlen(s) + 1);
	return 0;
}


template <size_t N>
inline errno_t strcpy_s(char (&d)[N], const char* s)
{
	return strcpy_s(d, N, s);
}
inline int fopen_s(FILE** fp, const char* path, const char* mode)
{
	if (!fp)
		return 1;
	*fp = Wyd_fopen(path, mode);
	return *fp ? 0 : 1;
}
inline int sprintf_s(char* d, size_t n, const char* fmt, ...)
{
	va_list ap;
	va_start(ap, fmt);
	const int r = vsnprintf(d, n, fmt, ap);
	va_end(ap);
	return r < 0 ? 1 : 0;
}
template <size_t N>
inline int sprintf_s(char (&d)[N], const char* fmt, ...)
{
	va_list ap;
	va_start(ap, fmt);
	const int r = vsnprintf(d, N, fmt, ap);
	va_end(ap);
	return r < 0 ? 1 : 0;
}
inline int vsprintf_s(char* d, size_t n, const char* fmt, va_list ap)
{
	return vsnprintf(d, n, fmt, ap);
}
template <size_t N>
inline int vsprintf_s(char (&d)[N], const char* fmt, va_list ap)
{
	return vsnprintf(d, N, fmt, ap);
}
inline errno_t strncpy_s(char* d, size_t n, const char* s, size_t count)
{
	if (!d || !s || !n)
		return 1;
	const size_t m = std::min(count, n - 1);
	std::strncpy(d, s, m);
	return 0;
}


template <size_t N>
inline errno_t strncpy_s(char (&d)[N], const char* s, size_t count)
{
	return strncpy_s(d, N, s, count);
}
inline char* _itoa(int v, char* buf, int /*radix*/)
{
	if (!buf)
		return nullptr;
	std::sprintf(buf, "%d", v);
	return buf;
}
inline long long _atoi64(const char* s) { return s ? std::atoll(s) : 0; }

using LPTHREAD_START_ROUTINE = DWORD (*)(void*);
inline HANDLE CreateThread(SECURITY_ATTRIBUTES* /*sa*/, SIZE_T /*stack*/, LPTHREAD_START_ROUTINE start, void* param, DWORD /*flags*/, LPDWORD id)
{
	pthread_t th {};
	struct Box { LPTHREAD_START_ROUTINE fn; void* arg; };
	auto* box = new Box{ start, param };
	pthread_create(&th, nullptr, [](void* p) -> void* {
		auto* b = static_cast<Box*>(p);
		auto fn = b->fn;
		auto arg = b->arg;
		delete b;
		if (fn)
			fn(arg);
		return nullptr;
	}, box);
	if (id)
		*id = static_cast<DWORD>(reinterpret_cast<uintptr_t>(th));
	return reinterpret_cast<HANDLE>(th);
}
