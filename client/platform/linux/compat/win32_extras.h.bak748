inline UINT GetSystemDirectoryA(LPSTR buf, UINT n)
{
	if (!buf || n < 2)
		return 0;
	std::strncpy(buf, ".", n);
	buf[n - 1] = 0;
	return 1;
}
inline DWORD GetModuleFileNameA(HMODULE, LPSTR buf, DWORD n)
{
	if (!buf || !n)
		return 0;
	ssize_t len = readlink("/proc/self/exe", buf, n - 1);
	if (len <= 0) {
		std::strncpy(buf, "wyd_client", n);
		buf[n - 1] = 0;
		return static_cast<DWORD>(std::strlen(buf));
	}
	buf[len] = 0;
	return static_cast<DWORD>(len);
}
#define GetModuleFileName GetModuleFileNameA
