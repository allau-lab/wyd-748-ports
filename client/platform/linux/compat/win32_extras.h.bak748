inline DWORD GetFileAttributesA(LPCSTR p)
{
	struct stat st {};
	if (!p || stat(p, &st) != 0)
		return static_cast<DWORD>(-1);
	return S_ISDIR(st.st_mode) ? 0x10u : 0x80u;
}
#define GetFileAttributes GetFileAttributesA
