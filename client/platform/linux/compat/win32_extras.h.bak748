#pragma push_macro("st_mtime")
#undef st_mtime
struct _stat64i32 {
	long long st_size;
	long st_mtime;
	int st_mode;
};
inline int _stat64i32(const char* path, _stat64i32* out)
{
	struct stat s {};
	const std::string npath = WYD_NormalizePath(path);
	if (stat(npath.c_str(), &s) != 0)
		return -1;
	if (out) {
		out->st_size = s.st_size;
#if defined(__linux__)
		out->st_mtime = static_cast<long>(s.st_mtim.tv_sec);
#else
		out->st_mtime = static_cast<long>(s.st_mtime);
#endif
		out->st_mode = static_cast<int>(s.st_mode);
	}
	return 0;
}


#pragma pop_macro("st_mtime")
