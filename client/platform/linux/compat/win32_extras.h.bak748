inline BOOL SetFileAttributesA(LPCSTR, DWORD) { return TRUE; }
#define SetFileAttributes SetFileAttributesA
inline BOOL CopyFileA(LPCSTR src, LPCSTR dst, BOOL failIfExists)
{
	if (!src || !dst)
		return FALSE;
	const std::string nsrc = WYD_NormalizePath(src);
	const std::string ndst = WYD_NormalizePath(dst);
	if (failIfExists && access(ndst.c_str(), F_OK) == 0)
		return FALSE;
	std::ifstream in(nsrc, std::ios::binary);
	if (!in)
		return FALSE;
	std::ofstream out(ndst, std::ios::binary);
	if (!out)
		return FALSE;
	out << in.rdbuf();
	return TRUE;
}
#define CopyFile CopyFileA

